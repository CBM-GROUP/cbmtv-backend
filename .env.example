# Local Docker Compose values. Never commit production secrets.
POSTGRES_DB=cbmtv
POSTGRES_USER=cbmtv
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_PORT=5433
APP_PORT=8001

SECRET_KEY=replace-with-a-long-random-django-secret
DEBUG=false
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8001
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8001

# Set DATABASE_URL only when running outside Compose.
# DATABASE_URL=postgresql://cbmtv:password@localhost:5433/cbmtv

RUN_MIGRATIONS=true
COLLECT_STATIC=true
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60

# Meilisearch. Read directly by content/views.py at import time (not via settings).
# Required for the /api/content/search/ reindex endpoint.
MEILISEARCH_URL=
MASTER_KEY=

# Media storage (backend only; never expose these as NEXT_PUBLIC_* variables)
MEDIA_STORAGE_PROVIDER=s3
AWS_CREDENTIALS_MODE=access_keys
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
MEDIA_CDN_DOMAIN=
# CloudFront fronts VIDEO only; images are served straight from the S3 bucket.
# Video delivery URLs use the FULL object key including the cbmvideo/ prefix.
# (The distribution previously had a /cbmvideo origin path which required the
# prefix to be stripped. It was removed, inverting that. Verify OriginPath on
# the distribution before changing any URL-shaping code.)
CLOUDFRONT_BASE_URL=
# Optional. Overrides the base URL for image delivery (e.g. an images-only
# CDN). Leave blank to serve images from the bucket's public S3 URL.
MEDIA_IMAGE_BASE_URL=
MEDIA_PRESIGNED_URL_TTL=3600
