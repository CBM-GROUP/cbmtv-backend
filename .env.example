# Local Docker Compose values. Never commit production secrets.
POSTGRES_DB=cbmtv
POSTGRES_USER=cbmtv
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_PORT=5433
APP_PORT=8001

SECRET_KEY=replace-with-a-long-random-django-secret
DEBUG=false
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8001
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8001

# Set DATABASE_URL only when running outside Compose.
# DATABASE_URL=postgresql://cbmtv:password@localhost:5433/cbmtv

RUN_MIGRATIONS=true
COLLECT_STATIC=true
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60
