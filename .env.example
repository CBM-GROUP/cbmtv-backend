# Local Docker Compose values. Never commit production secrets.
POSTGRES_DB=cbmtv
POSTGRES_USER=cbmtv
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_PORT=5433
APP_PORT=8001

SECRET_KEY=replace-with-a-long-random-django-secret
DEBUG=false
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
ALLOWED_HOSTS=apicbmtv.cbmgroupco.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://apicbmtv.cbmgroupco.com,https://cbmtv.cbmgroupco.com,https://cbmtv-dashboard-five.vercel.app
CORS_ALLOWED_ORIGINS=https://cbmtv.cbmgroupco.com,https://cbmtv-dashboard-five.vercel.app

# Setting CORS_ALLOWED_ORIGINS REPLACES the default allowlist in settings.py.
# Production sets it to the live frontends only, which is why the deployed API
# rejects every localhost origin and the stream app cannot be run locally
# against it. Leave this unset (or on) for a development instance to append the
# local frontend ports -- stream :3000/:3001, Expo web :8081/:19006 -- on top of
# whatever CORS_ALLOWED_ORIGINS lists. It is implied whenever DEBUG=true.
# Never set this on production; use CORS_ALLOWED_ORIGINS there instead.
CORS_ALLOW_LOCAL_DEV=false

# Set DATABASE_URL only when running outside Compose.
# DATABASE_URL=postgresql://cbmtv:password@localhost:5433/cbmtv

RUN_MIGRATIONS=true
COLLECT_STATIC=true
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60

# Meilisearch. Read via settings.py (MEILISEARCH_URL / MEILISEARCH_MASTER_KEY /
# MEILISEARCH_INDEX) and resolved per request, so leaving these blank degrades
# search to a clean 503 instead of breaking at import.
#   GET  /api/content/search/?q=   read-only search  (AllowAny)
#   POST /api/content/reindex/     rebuild the index (IsAdminUser)
MEILISEARCH_URL=
MASTER_KEY=
# Index name; defaults to "content".
# MEILISEARCH_INDEX=content

# Media storage (backend only; never expose these as NEXT_PUBLIC_* variables)
MEDIA_STORAGE_PROVIDER=s3
AWS_CREDENTIALS_MODE=access_keys
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
MEDIA_CDN_DOMAIN=
# CloudFront fronts VIDEO only; images are served straight from the S3 bucket.
# Video delivery URLs use the FULL object key including the cbmvideo/ prefix.
# (The distribution previously had a /cbmvideo origin path which required the
# prefix to be stripped. It was removed, inverting that. Verify OriginPath on
# the distribution before changing any URL-shaping code.)
CLOUDFRONT_BASE_URL=
# Optional. Overrides the base URL for image delivery (e.g. an images-only
# CDN). Leave blank to serve images from the bucket's public S3 URL.
MEDIA_IMAGE_BASE_URL=
# How long a presigned upload URL stays valid. The window is sized to the
# file: the dashboard sends size_bytes, and the backend allows
# size / MIN_UPLOAD_BYTES_PER_SEC + OVERHEAD seconds, clamped to [TTL, MAX_TTL].
# A flat hour used to fail large uploads at the very end, after every byte had
# already been sent. Raise MIN_UPLOAD_BYTES_PER_SEC if windows feel too long;
# lower it if uploads on poor connections still expire. AWS caps SigV4
# presigned URLs at 7 days (604800).
MEDIA_PRESIGNED_URL_TTL=3600
MEDIA_PRESIGNED_URL_MAX_TTL=43200
MEDIA_MIN_UPLOAD_BYTES_PER_SEC=102400
MEDIA_PRESIGNED_URL_OVERHEAD=300
# Single-part PUT limit. S3 rejects anything above 5 GiB; multipart is not
# implemented, so the backend refuses it up front rather than after the upload.
MEDIA_MAX_UPLOAD_BYTES=5368709120
